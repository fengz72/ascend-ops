#include "_prefix_attn_metadata_kernel_args.h"
extern __global__ __aicpu__ uint32_t _prefix_attn_metadata_kernel(_PrefixAttnMetadataArgs);
extern "C" void _prefix_attn_metadata_kernel_do(void* stream, uint64_t a_bounds, uint64_t a_metadata, uint32_t a_bounds_len, uint32_t a_num_heads_q, uint32_t a_num_heads_kv, uint32_t a_aic_core_num, uint32_t a_macro_cost)
{
    _PrefixAttnMetadataArgs s;
    s.bounds = (const int32_t*)a_bounds;
    s.metadata = (uint32_t*)a_metadata;
    s.bounds_len = a_bounds_len;
    s.num_heads_q = a_num_heads_q;
    s.num_heads_kv = a_num_heads_kv;
    s.aic_core_num = a_aic_core_num;
    s.macro_cost = a_macro_cost;
    _prefix_attn_metadata_kernel<<<1, 0, stream>>>(s);
}
